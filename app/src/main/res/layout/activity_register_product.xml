<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Administracion de productos"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresa la informacion del nuevo producto."
            android:textSize="15sp"
            android:textColor="#64748B"
            android:layout_marginBottom="22dp"/>

        <EditText
            android:id="@+id/edtCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Codigo del producto *"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nombre del producto *"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtCategory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Categoria"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:hint="Descripcion del producto"
            android:gravity="top"
            android:inputType="textCapSentences|textMultiLine"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtPrice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Precio unitario *"
            android:inputType="numberDecimal|numberSigned"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Existencias *"
            android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtMinimumStock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Stock minimo"
            android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtSupplier"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Proveedor"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSaveProduct"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar producto"/>

    </LinearLayout>

</ScrollView>
